{
  "schemaVersion": 1,
  "id": "dioxide-lite",
  "version": "${version}",
  "name": "DioxideLite",
  "description": "A mod that brings many practical small features to high-version Minecraft PVP.",
  "authors": [
    "Nachoneko_miao",
    "yajiyi114514"
  ],
  "contact": {
    "homepage": "https://space.bilibili.com/3546915648047958"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/dioxide-lite/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.dioxidelite.DioxideLite"
    ],
    "client": [
      "com.dioxidelite.DioxideLiteClient"
    ]
  },
  "mixins": [
    "dioxide-lite.mixins.json",
    {
      "config": "dioxide-lite.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "dioxide-lite.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
